eld whose\n// declared type is a generic parameter. Such fields are translated with type\n// void, so these projections have a *void base.\n\nuse std::cmp::Ordering;\n\nenum MyErr {\n    X,\n    Y,\n}\n\nstruct S {\n    x: i32,\n}\n\nstruct W<T> {\n    inner: T,\n}\n\nstruct P<T>(T);\n\nfn some_ordering(o: Option<Ordering>) -> i32 {\n    match o {\n        Some(Ordering::Less) => 1,\n        _ => 0,\n    }\n}\n\nfn err_variant(r: Result<i32, MyErr>) -> i32 {\n    match r {\n        Err(MyErr::X) => 1,\n        Err(MyErr::Y) => 2,\n        Ok(_) => 0,\n    }\n}\n\nfn ok_some(r: Result<Option<i32>, i32>) -> i32 {\n    match r {\n        Ok(Some(v)) => v,\n        _ => 0,\n    }\n}\n\nfn some_some(o: Option<Option<i32>>) -> i32 {\n    match o {\n        Some(Some(v)) => v,\n        _ => 0,\n    }\n}\n\nfn some_struct(o: &Option<S>) -> i32 {\n    match o {\n        Some(S { x }) => *x,\n        None => 0,\n    }\n}\n\nfn generic_field(w: &W<Option<i32>>) -> i32 {\n    match w.inner {\n        Some(v) => v,\n        None => 0,\n    }\n}\n\nfn generic_tuple_field(p: &P<Option<i32>>) -> i32 {\n    match p.0 {\n        Some(v) => v,\n        None => 0,\n    }\n}\n\nfn write_generic_field(w: &mut W<S>) {\n    w.inner.x = 1;\n}\n\nfn main() {}\n"},{"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["generic_enum_nested",0]},{"Ident":["MyErr",0]}],"span":{"data":{"file_id":0,"beg":{"line":7,"col":0},"end":{"line":10,"col":1}},"generated_fro