\nfn ok_arm_bad() -> i32 {\n    let r: Result<i32, i32> = Ok(1);\n    let p = 0 as *const i32;\n    match r {\n        Ok(_) => unsafe { *p },\n        Err(e) => e,\n    }\n}\n\nfn for_loop_bad(n: i32) -> i32 {\n    let mut s = 0;\n    for i in 0..n {\n        s += i;\n    }\n    let p = 0 as *const i32;\n    unsafe { *p + s }\n}\n\nfn question_bad(r: Result<i32, i32>) -> Result<i32, i32> {\n    let v = r?;\n    let p = 0 as *const i32;\n    Ok(unsafe { *p } + v)\n}\n\n// FP: the discriminant read yields the address of the discriminant field, not\n// its value, so Pulse explores every arm of the match, including this one,\n// which cannot run.\nfn FP_dead_none_arm_ok() -> i32 {\n    let o = Some(1);\n    let p = 0 as *const i32;\n    match o {\n        None => unsafe { *p },\n        Some(v) => v,\n    }\n}\n\n// FN: Pulse does not copy the fields of a struct or enum value on a\n// whole-value copy, so the payload of `o2` is not known to be null.\nfn FN_copied_option_bad() -> i32 {\n    let o = Some(0 as *const i32);\n    let o2 = o;\n    match o2 {\n        Some(p) => unsafe { *p },\n        None => 0,\n    }\n}\n\nfn main() {}\n"},{"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"nam